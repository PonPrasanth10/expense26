# Required
MONGODB_URI=mongodb+srv://<username>:<password>@<cluster>.mongodb.net/studentspend?retryWrites=true&w=majority

# Auth.js (NextAuth)
AUTH_SECRET=your-super-secret-key-at-least-32-chars
AUTH_URL=http://localhost:3000

# Google OAuth (optional but recommended)
AUTH_GOOGLE_ID=your-google-client-id.apps.googleusercontent.com
AUTH_GOOGLE_SECRET=your-google-client-secret

# Email (for password reset) - using Resend
RESEND_API_KEY=re_your_resend_api_key
EMAIL_FROM=noreply@studentspend.in

# App
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Feature flags
NEXT_PUBLIC_FEATURE_INSIGHTS=false
